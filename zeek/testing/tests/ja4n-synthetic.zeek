# JA4N across NTP versions, modes, leap indicators, strata, poll and
# precision extremes, timestamp boundaries, IPv4/IPv6, unusual reference ids,
# truncated and malformed payloads, multi-packet flows and non-NTP ports.
#
# arkime-reference holds the distinct fingerprints per connection produced by
# running the JA4N code from arkime/ja4 ja4plus.c (commit
# 27099fb11f351f35d69f4ce366374aa91536af04), compiled verbatim, over this pcap
# with Arkime's UDP session and classifier semantics. They are not output of
# this plugin.
#
# messages-reference breaks that down per message: one line per packet the
# reference semantics fingerprint, keyed by the packet's timestamp. It was
# produced by running src/ja4n.cc outside Zeek over the pcap with the same
# classification rules, and its distinct values per connection are exactly
# arkime-reference, which the first check confirms.
#
# Every ntp.log record must carry the fingerprint of its own message:
#  * "unexpected": records whose ja4n is not the reference value for that
#    packet (must be empty).
#  * "lost": records without a ja4n for a packet that has a reference value
#    (must be empty).
#  * "missing": fingerprinted packets that get no ntp.log record at all
#    because Zeek's NTP analyzer does not log them (mode 0, mode 6/7, or a
#    payload it cannot parse). Their fingerprints are not logged anywhere.
#
# @TEST-EXEC: zeek -C -r $TRACES/ja4n-synthetic.pcap %INPUT
# @TEST-EXEC: test ! -f ja4n.log
# @TEST-EXEC: cut -f2- messages-reference | sort -u | diff -u arkime-reference -
# @TEST-EXEC: %DIR/../scripts/ja4n-check-fields < ntp.log
# @TEST-EXEC: %DIR/../scripts/ja4n-messages < ntp.log > logged
# @TEST-EXEC: awk -F'\t' '$4 != "-"' logged | comm -23 - messages-reference > unexpected
# @TEST-EXEC: diff -u /dev/null unexpected
# @TEST-EXEC: awk -F'\t' 'BEGIN { OFS = "\t" } $4 == "-" { print $1, $2, $3 }' logged | sort > unfingerprinted
# @TEST-EXEC: cut -f1-3 messages-reference | sort | comm -12 unfingerprinted - > lost
# @TEST-EXEC: diff -u /dev/null lost
# @TEST-EXEC: awk -F'\t' 'BEGIN { OFS = "\t" } NR == FNR { seen[$1 FS $2 FS $3] = 1; next } !(($1 FS $2 FS $3) in seen) { print $2, $3, $4 }' logged messages-reference > missing
# @TEST-EXEC: btest-diff missing

